# ========================================
# CONFIGURAÇÃO DE API POR AMBIENTE
# ========================================

# URL principal da API (obrigatória)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.com

# URLs específicas por ambiente (opcional - fallback automático)
NEXT_PUBLIC_DEV_API_URL=http://localhost:8000
NEXT_PUBLIC_STAGING_API_URL=https://your-staging-url.com
NEXT_PUBLIC_PROD_API_URL=https://your-production-url.com

# Ambiente atual
NEXT_PUBLIC_ENVIRONMENT=development

# ========================================
# CONFIGURAÇÕES DE PERFORMANCE
# ========================================

# Timeout de requisições (ms)
NEXT_PUBLIC_REQUEST_TIMEOUT=15000

# Versão da API
NEXT_PUBLIC_API_VERSION=v1

# ========================================
# DEBUG E MONITORAMENTO
# ========================================

# Debug ativo (boolean)
NEXT_PUBLIC_ENABLE_DEBUG=false

# Analytics e Monitoramento
NEXT_PUBLIC_GA_ID=your_google_analytics_id
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Feature Flags
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# ========================================
# AUTENTICAÇÃO (Server-side apenas)
# ========================================
# NUNCA exponha credenciais com NEXT_PUBLIC_*

ADMIN_PASSWORD=your_secure_password_here
