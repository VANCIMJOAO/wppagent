# 🔐 EXEMPLO DE CONFIGURAÇÃO SEGURA - WPPAgent Dashboard
# Copie este arquivo para .env.local e configure com valores reais

# ✅ API Configuration (Público - pode usar NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=https://sua-app-production.up.railway.app
NEXT_PUBLIC_API_URL=https://sua-app-production.up.railway.app
NEXT_PUBLIC_ENVIRONMENT=production

# ✅ Backend Configuration (Público)
BACKEND_URL=https://sua-app-production.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://sua-app-production.up.railway.app

# ✅ WebSocket Configuration (Público)
NEXT_PUBLIC_WS_URL=wss://sua-app-production.up.railway.app/ws

# 🚨 CRÍTICO: Authentication (Server-side APENAS - NUNCA usar NEXT_PUBLIC_*)
# ⚠️  Configure credenciais seguras únicas para sua aplicação
ADMIN_USERNAME=seu_admin_usuario_seguro
ADMIN_PASSWORD=sua_senha_super_segura_aqui_123!

# 🔧 Opcional: Analytics and Monitoring (Público)
NEXT_PUBLIC_GA_ID=seu_google_analytics_id
NEXT_PUBLIC_SENTRY_DSN=seu_sentry_dsn

# 📋 INSTRUÇÕES DE SEGURANÇA:
# 1. NUNCA commite este arquivo com credenciais reais
# 2. Use senhas fortes e únicas
# 3. Considere rotação periódica de credenciais
# 4. Variáveis ADMIN_* ficam apenas no servidor (sem NEXT_PUBLIC_*)
