# Ambiente de Produção
NEXT_PUBLIC_API_BASE_URL=https://wppagent-production.up.railway.app
NEXT_PUBLIC_PROD_API_URL=https://wppagent-production.up.railway.app
NEXT_PUBLIC_ENVIRONMENT=production

