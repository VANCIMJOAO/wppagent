      "notes": "Cliente VIP atualizado via E2E"
    }
  },
  "selectors": {
    "appointments": {
      "page": "[data-testid='appointments-page']",
      "newButton": "button:has-text('Novo Agendamento')",
      "modal": "[role='dialog']",
      "form": {
        "clientSelect": "select[name='user_id']",
        "serviceSelect": "select[name='service_id']",
        "dateButton": "button:has-text('Selecione a data')",
        "timeSelect": "select[name='hora_agendamento']",
        "durationInput": "input[name='duracao_minutos']",
        "priceInput": "input[name='valor']",
        "notesTextarea": "textarea[name='observacoes']",
        "submitButton": "button:has-text('Criar')",
        "updateButton": "button:has-text('Atualizar')"
      },
      "list": "[data-testid='appointments-list']",
      "editButton": "button[title='Editar agendamento']",
      "deleteButton": "button[title='Excluir agendamento']"
    },
    "clients": {
      "page": "[data-testid='clients-page']",
      "newButton": "button:has-text('Novo Cliente')",
      "modal": "[role='dialog']",
      "form": {
        "nameInput": "input[name='nome']",
        "phoneInput": "input[name='telefone']",
        "emailInput": "input[name='email']",
        "statusSelect": "select[name='status']",
        "notesTextarea": "textarea[name='notas']",
        "submitButton": "button:has-text('Criar')",
        "updateButton": "button:has-text('Salvar Alterações')"
      },
      "list": "[data-testid='clients-list']",
      "editButton": "button[title='Editar cliente']",
      "deleteButton": "button[title='Excluir cliente']"
    },
    "common": {
      "successToast": ".toast-success",
      "errorToast": ".toast-error",
      "loadingSpinner": "[data-testid='loading-spinner']",
      "connectionStatus": "[data-testid='connection-status']",
      "errorMessage": "[data-testid='error-message']"
    }
  },
  "validations": {
    "requiredFields": {
      "appointment": ["user_id", "service_id", "data_agendamento", "hora_agendamento"],
      "client": ["nome", "telefone"]
    },
    "errorMessages": {
      "appointment": {
        "clientRequired": "Cliente é obrigatório",
        "serviceRequired": "Serviço é obrigatório",
        "dateRequired": "Data é obrigatória",
        "timeRequired": "Horário é obrigatório",
        "pastDate": "Data não pode ser no passado",
        "invalidTime": "Horário deve estar entre 8h e 18h",
        "negativeValue": "Valor não pode ser negativo"
      },
      "client": {
        "nameRequired": "Nome é obrigatório",
        "phoneRequired": "Telefone é obrigatório",
        "invalidEmail": "Email deve ter um formato válido",
        "invalidPhone": "Telefone deve conter apenas números e caracteres válidos"
      }
    }
  },
  "websocket": {
    "endpoint": "ws://localhost:3000/ws",
    "timeout": 10000,
    "reconnectAttempts": 3,
    "reconnectDelay": 1000
  },
  "performance": {
    "maxResponseTime": 5000,
    "maxLoadTime": 10000,
    "maxOperationTime": 30000
  },
  "accessibility": {
    "requiredAttributes": ["aria-label", "role", "aria-live"],
    "keyboardNavigation": true,
    "screenReader": true
  }
}



