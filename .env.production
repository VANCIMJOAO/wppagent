# ===================================================
# 🚀 CONFIGURAÇÃO DE PRODUÇÃO - CONVERSAS MODULE
# ===================================================
# Arquivo: .env.production
# Autor: Claude AI Assistant
# Data: 2025-01-27
# Status: Ready for Production ✅

# ===================================================
# 📱 API BACKEND INTEGRATION
# ===================================================
USE_API_BACKEND=true
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=your_api_key_here
API_TIMEOUT=30
API_RETRY_COUNT=3
API_FALLBACK_ENABLED=true

# ===================================================
# 🔄 WEBSOCKET REAL-TIME CONFIGURATION  
# ===================================================
USE_REAL_WEBSOCKET=true
WEBSOCKET_URL=ws://localhost:8000/ws/dashboard
WEBSOCKET_TIMEOUT=5000
WEBSOCKET_RECONNECT_INTERVAL=3000
WEBSOCKET_MAX_RETRIES=5
WEBSOCKET_AUTO_RECONNECT=true
WEBSOCKET_FALLBACK_POLLING=true

# ===================================================
# 🎯 PERFORMANCE OPTIMIZATIONS
# ===================================================
ENABLE_CACHING=true
CACHE_TTL=300
PAGINATION_SIZE=20
DEBOUNCE_DELAY=300
LAZY_LOADING=true
VIRTUAL_SCROLLING=true

# ===================================================
# 🔐 SECURITY CONFIGURATION
# ===================================================
JWT_SECRET_KEY=your_jwt_secret_here_change_in_production
SESSION_TIMEOUT=3600
CSRF_PROTECTION=true
RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100

# ===================================================
# 📊 MONITORING & LOGGING
# ===================================================
LOG_LEVEL=INFO
ENABLE_METRICS=true
PERFORMANCE_MONITORING=true
ERROR_TRACKING=true
ANALYTICS_ENABLED=true

# ===================================================
# 🌐 ENVIRONMENT SETTINGS
# ===================================================
ENVIRONMENT=production
DEBUG=false
TESTING=false

# ===================================================
# 📱 MOBILE OPTIMIZATIONS
# ===================================================
MOBILE_OPTIMIZATIONS=true
TOUCH_GESTURES=true
RESPONSIVE_IMAGES=true
PWA_ENABLED=true

# ===================================================
# 💾 DATABASE SETTINGS
# ===================================================
DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30

# ===================================================
# 🔧 CONVERSAS MODULE SPECIFIC
# ===================================================
MAX_MESSAGE_LENGTH=4096
CONVERSATION_CACHE_SIZE=100
REAL_TIME_UPDATES=true
MESSAGE_VALIDATION=true
WHATSAPP_API_INTEGRATION=true

# ===================================================
# ✅ FEATURE FLAGS
# ===================================================
FEATURE_WEBSOCKET_UPDATES=true
FEATURE_MESSAGE_VALIDATION=true
FEATURE_STORE_MANAGEMENT=true
FEATURE_API_INTEGRATION=true
FEATURE_PERFORMANCE_MODE=true
