def create_integration_detail_section(title, icon, color, details, actions):
    """
    Seção detalhada de uma integração específica.
    """
    detail_items = []
    for detail in details:
        detail_items.append(
            dmc.Group([
                dmc.Text(detail["label"] + ":", size="sm", c="dimmed"),
                dmc.Text(detail["value"], size="sm", fw=500)
            ], position="space-between")
        )
    
    return dmc.Group([
        dmc.ThemeIcon(
            DashIconify(icon=icon, width=24),
            color=color,
            variant="light",
            size="xl"
        ),
        
        dmc.Stack([
            dmc.Text(title, size="lg", fw=600),
            dmc.Stack(detail_items, spacing="xs"),
            dmc.Group(actions, spacing="sm") if actions else html.Div()
        ], spacing="sm")
        
    ], spacing="lg", align="flex-start")

