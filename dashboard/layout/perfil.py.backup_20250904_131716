def create_integration_status_card(name, status, color, icon, details):
    """
    Card de status de uma integração específica.
    """
    status_badge = dmc.Badge(status, color=color, variant="light", size="sm")
    
    detail_items = []
    for key, value in details.items():
        detail_items.append(
            dmc.Group([
                dmc.Text(key.replace("_", " ").title() + ":", size="xs", c="dimmed"),
                dmc.Text(value, size="xs", fw=500)
            ], position="space-between")
        )
    
    return dmc.Card([
        dmc.Stack([
            dmc.Group([
                dmc.ThemeIcon(
                    DashIconify(icon=icon, width=20),
                    color=color,
                    variant="light",
                    size="lg"
                ),
                dmc.Stack([
                    dmc.Text(name, fw=600, size="sm"),
                    status_badge
                ], spacing="xs")
            ], spacing="sm"),
            
            dmc.Divider(),
            
            dmc.Stack(detail_items, spacing="xs")
            
        ], spacing="md")
    ], shadow="sm", p="md", radius="md", className="integration-card")

