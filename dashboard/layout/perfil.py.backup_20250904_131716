def create_perfil_layout():
    """
    Layout da página de perfil com informações do usuário e configurações.
    
    Seções:
    - Header com informações básicas do usuário
    - Abas para Perfil, Notificações, Atividade e Integrações
    - Cards informativos e formulários
    """
    
    # Data stores para a página
    stores = html.Div([
        dcc.Store(id='user-profile-data', storage_type='session'),
        dcc.Store(id='notification-settings', storage_type='session'),
        dcc.Store(id='activity-logs', storage_type='session'),
    ])
    
    # Header da página
    page_header = create_page_header(
        title="Perfil do Usuário",
        subtitle="Gerencie suas informações pessoais, notificações e monitore a atividade do sistema",
        actions=[
            dmc.Button(
                "Salvar Alterações",
                leftIcon=DashIconify(icon="tabler:device-floppy", width=16, height=16),
                variant="filled",
                color="blue",
                id="save-profile-btn"
            ),
            dmc.Button(
                "Atualizar",
                leftIcon=DashIconify(icon="tabler:refresh", width=16, height=16),
                variant="light",
                id="refresh-profile-btn"
            )
        ]
    )
    
    # Conteúdo principal com abas
    main_content = create_profile_tabs()
    
    # Layout principal
    layout = dmc.Stack([
        # Stores invisíveis
        stores,
        
        # Cabeçalho da página
        page_header,
        
        # Conteúdo principal
        main_content
        
    ], spacing="xl", className="perfil-layout")
    
    return layout

def create_profile_tabs():
    """
    Cria o sistema de abas da página de perfil.
    """
    return dmc.Card([
        dmc.Tabs([
            dmc.TabsList([
                dmc.Tab("Perfil", value="profile", 
                       icon=DashIconify(icon="tabler:user", width=16)),
                dmc.Tab("Notificações", value="notifications", 
                       icon=DashIconify(icon="tabler:bell", width=16)),
                dmc.Tab("Atividade", value="activity", 
                       icon=DashIconify(icon="tabler:activity", width=16)),
                dmc.Tab("Integrações", value="integrations", 
                       icon=DashIconify(icon="tabler:plug", width=16))
            ]),
            
            dmc.TabsPanel([
                create_profile_tab()
            ], value="profile"),
            
            dmc.TabsPanel([
                create_notifications_tab()
            ], value="notifications"),
            
            dmc.TabsPanel([
                create_activity_tab()
            ], value="activity"),
            
            dmc.TabsPanel([
                create_integrations_tab()
            ], value="integrations")
            
        ], value="profile", orientation="horizontal", id="profile-tabs")
    ], shadow="sm", p="md", radius="md")

