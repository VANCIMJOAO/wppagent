def create_notification_category(title, icon, color, settings):
    """
    Cria uma categoria de configurações de notificação.
    """
    return dmc.Stack([
        dmc.Group([
            dmc.ThemeIcon(
                DashIconify(icon=icon, width=20),
                color=color,
                variant="light",
                size="lg"
            ),
            dmc.Text(title, size="md", fw=600)
        ], spacing="sm"),
        
        dmc.Stack([
            dmc.Stack([
                dmc.Text(setting["label"], size="sm", fw=500),
                dmc.Switch(
                    checked=setting["checked"],
                    id=setting["id"],
                    size="sm"
                )
            ], spacing="xs") for setting in settings
        ], spacing="sm", pl="xl")
        
    ], spacing="sm")

