{
  "files.exclude": {
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/htmlcov": true,
    "**/mutants": true,
    "**/temp_cleanup": true
  },
  "files.watcherExclude": {
    "**/*.cache": true,
    "**/*.pyc": true,
    "**/*.tmp": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/htmlcov/**": true,
    "**/logs/**": true,
    "**/mutants/**": true,
    "**/secrets/**": true,
    "**/temp_cleanup/**": true
  },
  "python.defaultInterpreterPath": "python",
  "python.terminal.activateEnvironment": false,
  "search.exclude": {
    "**/__pycache__": true,
    "**/htmlcov": true,
    "**/logs": true,
    "**/mutants": true,
    "**/secrets": true,
    "**/temp_cleanup": true
  }
}
