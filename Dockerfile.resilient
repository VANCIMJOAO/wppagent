# 🐳 Resilient Dockerfile with Multiple Image Sources
# Fallback strategy for Docker Hub issues

# Option 1: Use specific Python version with digest (most reliable)
FROM python@sha256:5d15266bbc7e2968c74fb93e8b54e70f4a21aae1f0e36e37b8a8e6fcf4b0a42b AS python-digest

# Option 2: Alternative registries if Docker Hub fails
# FROM ghcr.io/python/python:3.11-slim AS python-ghcr
# FROM quay.io/python/python:3.11-slim AS python-quay

# Use the primary option
FROM python-digest AS base

# Add retry logic for package installation
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Security: Create non-root user
RUN useradd --create-home --shell /bin/bash app

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install dependencies with retry logic
RUN for i in 1 2 3; do \
    pip install --no-cache-dir --retries 3 --timeout 60 -r requirements.txt && break || sleep 10; \
    done

# Copy application code
COPY . .

# Set ownership to app user
RUN chown -R app:app /app

# Switch to non-root user
USER app

# Expose port
EXPOSE 8000

# Health check (using python instead of curl)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Start application with security
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]