[run]
source = app
omit = 
    app/main.py.backup.*
    app/*backup*
    app/*/backup*
    tests/*
    venv/*
    .venv/*
    */tests/*
    */test_*
    */migrations/*
    alembic/*
    docs/*
    */templates/*
    */static/*
    .pytest_cache/*
    htmlcov/*
    
[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
    
precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
title = WhatsApp Agent Coverage Report

[json]
output = coverage.json