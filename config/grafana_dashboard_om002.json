          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "sum(alert_active{severity=\"critical\"})",
            "legendFormat": "Critical",
