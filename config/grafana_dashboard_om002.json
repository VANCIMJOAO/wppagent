{
  "dashboard": {
    "id": null,
    "title": "WhatsApp Agent Overview - OM002",
    "description": "Dashboard de observabilidade completo para WhatsApp Agent API",
    "tags": ["whatsapp", "webhook", "business", "om002", "observability"],
    "timezone": "America/Sao_Paulo",
    "refresh": "30s",
    "schemaVersion": 30,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "panels": [
      {
        "id": 1,
        "title": "🚨 Webhook Failure Rate",
        "type": "stat",
        "description": "Taxa de falha do webhook em tempo real (OM003 Alert: >10%)",
        "targets": [
          {
            "expr": "rate(webhook_errors_total[5m]) / rate(webhook_requests_total[5m]) * 100",
            "legendFormat": "Failure Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            },
            "mappings": []
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "📤 Messages Sent Rate",
        "type": "stat",
        "description": "Taxa de mensagens enviadas por minuto",
        "targets": [
          {
            "expr": "rate(whatsapp_messages_sent_total[5m]) * 60",
            "legendFormat": "Messages/min",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "📅 Appointments Created Today",
        "type": "stat",
        "description": "Total de agendamentos criados nas últimas 24h",
        "targets": [
          {
            "expr": "increase(appointments_created_total[24h])",
            "legendFormat": "Appointments",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 10}
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "🔍 System Health Components",
        "type": "table",
        "description": "Status de saúde de todos os componentes (OM001)",
        "targets": [
          {
            "expr": "health_component_status",
            "legendFormat": "{{component}}: {{status}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "color-background"
            },
            "mappings": [
              {
                "options": {
                  "healthy": {"color": "green", "index": 0},
                  "degraded": {"color": "yellow", "index": 1},
                  "unhealthy": {"color": "red", "index": 2}
                },
                "type": "value"
              }
            ]
          }
        },
        "options": {
          "showHeader": true
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "⚡ Webhook Response Times",
        "type": "timeseries",
        "description": "Latência do webhook (OM003 Alert: >5000ms)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, webhook_duration_seconds_bucket)",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, webhook_duration_seconds_bucket)", 
            "legendFormat": "50th percentile",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, webhook_duration_seconds_bucket)",
            "legendFormat": "99th percentile",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 1,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "",
              "axisColorMode": "text",
              "scaleDistribution": {"type": "linear"},
              "hideFrom": {"legend": false, "tooltip": false, "vis": false},
              "thresholdsStyle": {"mode": "off"}
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 5}
              ]
            }
          }
        },
        "options": {
          "tooltip": {"mode": "single", "sort": "none"},
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull", "max"]}
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "💬 Message Volume by Hour",
        "type": "timeseries",
        "description": "Volume de mensagens recebidas vs enviadas",
        "targets": [
          {
            "expr": "rate(whatsapp_messages_received_total[1h])",
            "legendFormat": "Messages In",
            "refId": "A"
          },
          {
            "expr": "rate(whatsapp_messages_sent_total[1h])",
            "legendFormat": "Messages Out",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 20,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "",
              "axisColorMode": "text",
              "scaleDistribution": {"type": "linear"},
              "hideFrom": {"legend": false, "tooltip": false, "vis": false},
              "thresholdsStyle": {"mode": "off"}
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "none"},
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull", "max"]}
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "🚨 Active Alerts Summary",
        "type": "stat",
        "description": "Resumo de alertas ativos (OM003)",
        "targets": [
          {
            "expr": "sum(alert_active{severity=\"critical\"})",
            "legendFormat": "Critical",
            "refId": "A"
          },
          {
            "expr": "sum(alert_active{severity=\"warning\"})",
            "legendFormat": "Warning", 
            "refId": "B"
          },
          {
            "expr": "sum(alert_active{severity=\"info\"})",
            "legendFormat": "Info",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 3}
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "background"
        },
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 8,
        "title": "💾 Database Performance",
        "type": "timeseries",
        "description": "Métricas de performance do PostgreSQL",
        "targets": [
          {
            "expr": "database_response_time_ms",
            "legendFormat": "DB Response Time (ms)",
            "refId": "A"
          },
          {
            "expr": "database_connections_active",
            "legendFormat": "Active Connections",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 10
            }
          }
        },
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 16}
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "enable": true,
          "expr": "changes(app_build_info[1d])",
          "step": "1m",
          "iconColor": "blue",
          "tags": ["deployment", "release"]
        },
        {
          "name": "Critical Alerts",
          "datasource": "prometheus", 
          "enable": true,
          "expr": "alert_active{severity=\"critical\"}",
          "step": "30s",
          "iconColor": "red",
          "tags": ["alert", "critical"]
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "instance",
          "query": "label_values(up, instance)",
          "type": "query",
          "datasource": "prometheus",
          "refresh": 1,
          "includeAll": false,
          "multi": false
        },
        {
          "name": "component",
          "query": "label_values(health_component_status, component)",
          "type": "query", 
          "datasource": "prometheus",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "links": [
      {
        "title": "Health Check Detalhado",
        "url": "/health/detailed",
        "type": "absolute"
      },
      {
        "title": "Alertas Ativos",
        "url": "/health/alerts",
        "type": "absolute"
      },
      {
        "title": "Logs Estruturados",
        "url": "/logs",
        "type": "absolute"
      }
    ]
  },
