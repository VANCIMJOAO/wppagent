{
  "dashboard": {
    "annotations": {
      "list": [
        {
          "datasource": "prometheus",
          "enable": true,
          "expr": "changes(app_build_info[1d])",
          "iconColor": "blue",
          "name": "Deployments",
          "step": "1m",
          "tags": [
            "deployment",
            "release"
          ]
        },
        {
          "datasource": "prometheus",
          "enable": true,
          "expr": "alert_active{severity=\"critical\"}",
          "iconColor": "red",
          "name": "Critical Alerts",
          "step": "30s",
          "tags": [
            "alert",
            "critical"
          ]
        }
      ]
    },
    "description": "Dashboard de observabilidade completo para WhatsApp Agent API",
    "id": null,
    "links": [
      {
        "title": "Health Check Detalhado",
        "type": "absolute",
        "url": "/health/detailed"
      },
      {
        "title": "Alertas Ativos",
        "type": "absolute",
        "url": "/health/alerts"
      },
      {
        "title": "Logs Estruturados",
        "type": "absolute",
        "url": "/logs"
      }
    ],
    "panels": [
      {
        "description": "Taxa de falha do webhook em tempo real (OM003 Alert: >10%)",
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "background",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "rate(webhook_errors_total[5m]) / rate(webhook_requests_total[5m]) * 100",
            "legendFormat": "Failure Rate %",
            "refId": "A"
          }
        ],
        "title": "\ud83d\udea8 Webhook Failure Rate",
        "type": "stat"
      },
      {
        "description": "Taxa de mensagens enviadas por minuto",
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "id": 2,
        "options": {
          "colorMode": "value",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "rate(whatsapp_messages_sent_total[5m]) * 60",
            "legendFormat": "Messages/min",
            "refId": "A"
          }
        ],
        "title": "\ud83d\udce4 Messages Sent Rate",
        "type": "stat"
      },
      {
        "description": "Total de agendamentos criados nas \u00faltimas 24h",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "green",
                  "value": 10
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "id": 3,
        "options": {
          "colorMode": "background",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "increase(appointments_created_total[24h])",
            "legendFormat": "Appointments",
            "refId": "A"
          }
        ],
        "title": "\ud83d\udcc5 Appointments Created Today",
        "type": "stat"
      },
      {
        "description": "Status de sa\u00fade de todos os componentes (OM001)",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "color-background"
            },
            "mappings": [
              {
                "options": {
                  "degraded": {
                    "color": "yellow",
                    "index": 1
                  },
                  "healthy": {
                    "color": "green",
                    "index": 0
                  },
                  "unhealthy": {
                    "color": "red",
                    "index": 2
                  }
                },
                "type": "value"
              }
            ]
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "id": 4,
        "options": {
          "showHeader": true
        },
        "targets": [
          {
            "expr": "health_component_status",
            "format": "table",
            "legendFormat": "{{component}}: {{status}}",
            "refId": "A"
          }
        ],
        "title": "\ud83d\udd0d System Health Components",
        "type": "table"
      },
      {
        "description": "Lat\u00eancia do webhook (OM003 Alert: >5000ms)",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "insertNulls": false,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            },
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "id": 5,
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, webhook_duration_seconds_bucket)",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, webhook_duration_seconds_bucket)",
            "legendFormat": "50th percentile",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, webhook_duration_seconds_bucket)",
            "legendFormat": "99th percentile",
            "refId": "C"
          }
        ],
        "title": "\u26a1 Webhook Response Times",
        "type": "timeseries"
      },
      {
        "description": "Volume de mensagens recebidas vs enviadas",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "axisColorMode": "text",
              "axisLabel": "",
