# Configurações de Produção - Sistema de Monitoramento
# ====================================================

# Redis Configuration (Railway)
REDIS_URL=redis://default:SvSHiMNuuQEtmIUgGIEGqPpXsdZeInDG@yamanote.proxy.rlwy.net:14106

# Logs estruturados
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION_SIZE_MB=50
LOG_BACKUP_COUNT=10

# Alertas
ALERT_EMAIL_ENABLED=false
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@whatsapp-agent.com
ALERT_TO_EMAILS=admin@empresa.com

# Slack (opcional)
SLACK_WEBHOOK_URL=

# WhatsApp Alerts (opcional)
ALERT_WHATSAPP_PHONE=
WHATSAPP_API_TOKEN=

# Monitoramento
PERFORMANCE_CHECK_INTERVAL=60
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=95
MEMORY_WARNING_THRESHOLD=85
MEMORY_CRITICAL_THRESHOLD=95
DISK_WARNING_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=95

# Backups
BACKUP_DIR=backups
BACKUP_MAX_RETENTION=30
BACKUP_COMPRESS=true
BACKUP_DAILY_TIME=02:00

# Business Metrics
METRICS_STORAGE_PATH=logs/business_metrics
METRICS_RETENTION_DAYS=90
