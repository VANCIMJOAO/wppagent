# 🚄 Emergency Railway Dockerfile - Minimal for debugging
FROM python:3.11-slim@sha256:a0939570b38cddeb861b8e75d20b1c8218b21562b18f301171904b544e8cf228

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8000
ENV RAILWAY_FAST_START=true

# Security: Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 app

# Set working directory
WORKDIR /app

# Install minimal dependencies only
RUN pip install --no-cache-dir fastapi uvicorn

# Copy only emergency app
COPY app/main_emergency.py .

# Set ownership
RUN chown -R app:app /app

# Switch to non-root user
USER app

# Expose port
EXPOSE $PORT

# Ultra-simple health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/ping', timeout=5)" || exit 1

# Start emergency app
CMD ["sh", "-c", "python -m uvicorn main_emergency:emergency_app --host 0.0.0.0 --port $PORT"]